    "note": "三栏制：decided 已决策 / pending 待决策 / assumed 假设。深化阶段 pending 已清零，assumed 全部取得书面确认后方可进入施工图。",
    "decided": [
      {
        "id": "D-01",
        "topic": "规模与控规指标",
        "decision": "用地 14772 m²；A 1488×4 + B 1488×5 + C 1848×6 + D 880×3 = 27120 m²；FAR 27120/14772 = 1.8359 ≤ 2.0；密度 5704/14772 = 38.61% ≤ 40%；绿地 6870 m² = 46.51% ≥ 35%",
        "basis": "limits 为示例控规条件（虚构）；算法口径同 references/checklist.md 指标算法"
      },
      {
        "id": "D-02",
        "topic": "层高与层数",
        "decision": "统一层高 3.6m（project.level_height）：A 4F=14.4m、B 5F=18.0m、C 6F=21.6m、D 3F=10.8m，均低于 limits.height_m 24.0m",
        "basis": "masses 的 height 均为 3.6 的整数倍，剖面与层高表一致"
      },
      {
        "id": "D-03",
        "topic": "模数协调",
        "decision": "建筑、门窗与铺装统一 300mm 扩大模数：design.module_mm = facade.module_mm = 300；窗宽系列 600 / 1200 / 1800 互为整数倍",
        "basis": "GB/T 50002-2013《建筑模数协调标准》扩大模数口径"
      },
      {
        "id": "D-04",
        "topic": "窗宽系列与示例占位差异（待核）",
        "decision": "[待核] 示例 elements 中 A/B 栋单窗按 2200mm 绘制，属概念阶段占位，不在 300mm 模数系列内；深化立面应按 1800mm 双窗重排，并回改 elements 后同步三张图纸。本次只新增字段，未改动 elements 坐标与门窗尺寸，以保证总平面/平面/剖面与 DXF/GLB 对位",
        "basis": "facade.windows_mm 与 openings 取标准系列 600/1200/1800；elements 为图纸几何，改动会使三图错位"
      },
      {
        "id": "D-05",
        "topic": "绿化与停车",
        "decision": "绿地 6870 m²（46.51%）；机动车 42 位全部地下（地下车库 2112 m²，约 50 m²/位含通道）；非机动车 260 位分 6 处车棚沿主环路西侧（x 80~88）与入口广场东侧布置",
        "basis": "GB/T 51346-2019《城市绿地规划标准》绿地口径；非机动车配建指标按地方规定[待核]"
      },
      {
        "id": "D-06",
        "topic": "场地排水",
        "decision": "雨污分流；场地按 0.3%~0.6% 找坡；5 条路径（4 条地面 + 1 条屋面内排水，见 drainage）全部重力排向南侧市政雨水接口 DN600",
        "basis": "GB 50037-2013《建筑地面设计规范》地面最小坡度常用控制值；GB 50108-2008《地下工程防水技术规范》地下室防水做法[待核：海绵城市年径流总量控制率由地方确定]"
      },
      {
        "id": "D-07",
        "topic": "无障碍",
        "decision": "4 个出入口连续无障碍：E-01 坡度 1:20、E-02 1:20、E-04 1:12，台阶高差 0~8mm；场地最大高差 0.45m 由缓坡消化",
        "basis": "GB 50763-2012《无障碍设计规范》轮椅坡道坡度常用控制值"
      },
      {
        "id": "D-08",
        "topic": "覆土与种植",
        "decision": "地下室顶板覆土 1500mm（basement.cover_mm）；覆土区只植小乔木/灌木/地被，大乔木 1800~2000mm 覆土全部布置在地面层（trees）",
        "basis": "GB/T 51346-2019 种植土厚度常用控制值[待核：结构荷载按 12 kN/m³ 复核]"
      },
      {
        "id": "D-09",
        "topic": "室内净高",
        "decision": "教室 3.6m 层高 − 0.7m 梁高 = 净高 2.9m；走廊吊顶下 2.6m；地下车库行车道 2.6m；门厅两层挑空 6.3m（见 clearances）",
        "basis": "GB 50352-2019《民用建筑设计统一标准》室内净高常用控制值"
      },
      {
        "id": "D-10",
        "topic": "日照与光影校核",
        "decision": "按北纬 30.4° 真太阳时校核 3 个日期 × 3 个时刻（light_checks）；冬至 09:00 与 15:00 高度角 21.0°，用于验证中庭与架空层进深受光；综合楼 C 位于场地东侧，不遮挡 A/B 栋教室南向采光",
        "basis": "GB 50033-2013《建筑采光设计标准》采光系数口径；GB 50180-2018 日照标准[待核：当地日照分析软件与间距系数]"
      }
